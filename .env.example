# OpenAI (chat completions, memory routing & background topic extraction)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Tavily web search (live web retrieval for the single web_search tool)
TAVILY_API_KEY=tvly-...

# Database (Postgres connection for bitemporal hybrid memory layer)
# Local Docker Postgres (docker-compose up -d):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minimi
# Neon or remote Postgres:
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Backend API server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Frontend Next.js app
NEXT_PUBLIC_API_URL=http://localhost:3001
