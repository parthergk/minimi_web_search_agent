# Postgres database connection (Neon / pgvector)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/dbname?sslmode=require

# OpenAI (chat completions + text-embedding-3-small)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Tavily web search
TAVILY_API_KEY=tvly-...

# API server (optional)
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
